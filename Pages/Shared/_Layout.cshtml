@using Microsoft.AspNetCore.Http
@{
    string? usuarioSesion = Context.Session.GetString("UsuarioLogueado");
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Asesoría Legal Global</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Head", required: false)
</head>
<body>
    <!-- Cabecera común (Master Page) -->
    <header class="site-header">
        <div class="contenedor nav-contenedor">
            <a class="marca-sitio" asp-page="/Index">
                <img src="~/imagenes/logo 2.png" alt="Logo Asesoría Legal Global" class="marca-logo" />
                <div class="marca-texto">
                    <span class="marca-titulo">Asesoría Legal Global</span>
                    <span class="marca-subtitulo">Consultoría Jurídica Corporativa</span>
                </div>
            </a>

            <button type="button"
                    class="btn-hamburguesa"
                    id="btnMenuMovil"
                    aria-label="Abrir menú de navegación"
                    aria-expanded="false"
                    aria-controls="menuPrincipal">
                <span class="linea-hamburguesa"></span>
                <span class="linea-hamburguesa"></span>
                <span class="linea-hamburguesa"></span>
            </button>

            <nav class="nav-principal" id="menuPrincipal" aria-label="Navegación principal">
                <ul class="nav-lista">
                    <li><a class="nav-enlace" asp-page="/Index">Inicio</a></li>
                    @if (string.IsNullOrEmpty(usuarioSesion))
                    {
                        <li><a class="nav-enlace" asp-page="/Registro">Registro</a></li>
                        <li><a class="nav-enlace" asp-page="/Login">Iniciar Sesión</a></li>
                        <li><a class="nav-enlace" asp-page="/Documentos">Gestión Documental</a></li>
                    }
                    else
                    {
                        <li><a class="nav-enlace" asp-page="/Documentos">Mis Documentos</a></li>
                        <li class="nav-usuario-item">
                            <span class="badge-usuario">👤 @usuarioSesion</span>
                            <a class="btn-nav-salir" asp-page="/Salir">Cerrar Sesión</a>
                        </li>
                    }
                </ul>
            </nav>
        </div>
    </header>

    <!-- Contenido dinámico de cada página -->
    <main class="contenido-principal">
        <div class="contenedor">
            @RenderBody()
        </div>
    </main>

    <!-- Pie de página común persistente -->
    <footer class="site-footer">
        <div class="contenedor footer-contenedor">
            <p>&copy; @DateTime.Now.Year <strong>Asesoría Legal Global</strong>. Todos los derechos reservados.</p>
            <p class="footer-detalle">Sistema Seguro de Gestión de Documentos Legales</p>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script>
        (function () {
            const btnMenu = document.getElementById('btnMenuMovil');
            const menu = document.getElementById('menuPrincipal');
            if (btnMenu && menu) {
                btnMenu.addEventListener('click', function () {
                    const abierto = menu.classList.toggle('abierto');
                    btnMenu.classList.toggle('activo', abierto);
                    btnMenu.setAttribute('aria-expanded', abierto ? 'true' : 'false');
                });
            }
        })();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

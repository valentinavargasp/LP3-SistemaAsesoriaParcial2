@page
@model DocumentosModel
@{
    ViewData["Title"] = "Gestión de Documentos Legales";
}

<div class="panel-documentos-grid">
    <!-- Columna Izquierda: Perfil del Espacio Personal -->
    <aside class="tarjeta">
        <div class="tarjeta-encabezado">
            <img src="~/imagenes/logo 2.png" alt="Logo Asesoría Legal" class="marca-logo" style="margin-bottom: 0.5rem;" />
            <h2 class="tarjeta-titulo" style="font-size: 1.25rem;">Mi Espacio Personal</h2>
            <p class="tarjeta-subtitulo">Sesión de cliente verificada</p>
        </div>

        @if (!string.IsNullOrEmpty(Model.NombreCompletoActual))
        {
            <div class="perfil-item">
                <span class="perfil-etiqueta">Cliente Titular</span>
                <span class="perfil-valor">@Model.NombreCompletoActual</span>
            </div>
        }

        <div class="perfil-item">
            <span class="perfil-etiqueta">Usuario en Sesión</span>
            <span class="perfil-valor">@Model.UsuarioActual</span>
        </div>

        @if (!string.IsNullOrEmpty(Model.EmailActual))
        {
            <div class="perfil-item">
                <span class="perfil-etiqueta">Correo Electrónico</span>
                <span class="perfil-valor">@Model.EmailActual</span>
            </div>
        }

        <div class="perfil-item">
            <span class="perfil-etiqueta">Archivos Resguardados</span>
            <span class="perfil-valor">@Model.ArchivosGuardados.Count documento(s)</span>
        </div>

        <a asp-page="/Salir" class="btn btn-secundario btn-bloque">Cerrar Sesión</a>
    </aside>

    <!-- Columna Derecha: Subida y Listado de Documentos -->
    <div>
        <section class="tarjeta" style="margin-bottom: 1.5rem;">
            <div class="encabezado-subida">
                <img src="~/imagenes/logo 1.png" alt="Icono Consultoría Legal" />
                <div>
                    <h1 class="tarjeta-titulo" style="font-size: 1.35rem;">Cargar Documento Legal</h1>
                    <p class="tarjeta-subtitulo">Formatos admitidos: PDF (.pdf), Word (.doc, .docx) o Texto (.txt) — Máx. 5 MB.</p>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(Model.MensajeExito))
            {
                <div class="alerta alerta-exito">@Model.MensajeExito</div>
            }

            @if (!string.IsNullOrEmpty(Model.MensajeError))
            {
                <div class="alerta alerta-error">@Model.MensajeError</div>
            }

            <form method="post" enctype="multipart/form-data">
                <div class="grupo-campo">
                    <label asp-for="DocumentoSubido" class="etiqueta">Seleccionar documento desde su equipo *</label>
                    <input asp-for="DocumentoSubido" type="file" class="control-input" />
                    <span asp-validation-for="DocumentoSubido" class="mensaje-error-campo"></span>
                </div>

                <button type="submit" class="btn btn-primario">Subir Documento al Repositorio</button>
            </form>
        </section>

        <section class="tarjeta">
            <h2 class="tarjeta-titulo" style="font-size: 1.25rem; margin-bottom: 1rem;">Documentos en mi Espacio</h2>

            @if (Model.ArchivosGuardados.Count == 0)
            {
                <p class="tarjeta-subtitulo">Todavía no ha subido ningún documento legal a su espacio personal.</p>
            }
            else
            {
                <ul class="lista-archivos">
                    @foreach (var archivo in Model.ArchivosGuardados)
                    {
                        <li class="item-archivo">
                            <span class="nombre-archivo">📄 @archivo</span>
                            <div class="acciones-archivo">
                                <a asp-page="/Documentos"
                                   asp-page-handler="Ver"
                                   asp-route-nombreArchivo="@archivo"
                                   target="_blank"
                                   class="btn btn-secundario btn-pequeno">
                                    Ver / Descargar
                                </a>
                                <button type="button"
                                        class="btn btn-peligro"
                                        data-archivo="@archivo"
                                        onclick="abrirModalEliminar(this.getAttribute('data-archivo'))">
                                    Eliminar
                                </button>
                            </div>
                        </li>
                    }
                </ul>
            }
        </section>
    </div>
</div>

<!-- Modal Personalizado de Confirmación para Eliminar -->
<div id="modalConfirmarEliminar" class="modal-overlay" role="dialog" aria-modal="true" aria-labelledby="modalTituloEliminar" hidden>
    <div class="modal-caja">
        <div class="modal-icono-alerta">⚠️</div>
        <h3 id="modalTituloEliminar" class="modal-titulo">Confirmar eliminación</h3>
        <p class="modal-texto">
            ¿Está seguro de que desea eliminar el documento <strong id="nombreArchivoModal"></strong> de su espacio personal?
        </p>
        <p class="modal-subtexto">Esta acción no se puede deshacer.</p>

        <form method="post" asp-page-handler="Eliminar" id="formEliminarDocumento">
            <input type="hidden" name="nombreArchivo" id="inputNombreArchivoEliminar" value="" />
            <div class="modal-acciones">
                <button type="button" class="btn btn-secundario btn-pequeno" onclick="cerrarModalEliminar()">
                    Cancelar
                </button>
                <button type="submit" class="btn btn-confirmar-peligro btn-pequeno">
                    Sí, eliminar documento
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function abrirModalEliminar(nombreArchivo) {
            const modal = document.getElementById('modalConfirmarEliminar');
            const textoArchivo = document.getElementById('nombreArchivoModal');
            const inputArchivo = document.getElementById('inputNombreArchivoEliminar');

            if (modal && textoArchivo && inputArchivo) {
                textoArchivo.textContent = '"' + nombreArchivo + '"';
                inputArchivo.value = nombreArchivo;
                modal.removeAttribute('hidden');
                modal.classList.add('activo');
            }
        }

        function cerrarModalEliminar() {
            const modal = document.getElementById('modalConfirmarEliminar');
            if (modal) {
                modal.classList.remove('activo');
                modal.setAttribute('hidden', 'hidden');
            }
        }

        // Cerrar modal al hacer clic fuera de la caja o presionar Escape
        document.addEventListener('click', function (e) {
            const modal = document.getElementById('modalConfirmarEliminar');
            if (modal && e.target === modal) {
                cerrarModalEliminar();
            }
        });

        document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape') {
                cerrarModalEliminar();
            }
        });
    </script>
}

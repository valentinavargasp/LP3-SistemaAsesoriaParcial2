@page
@model RegistroModel
@{
    ViewData["Title"] = "Registro de Clientes";
}

<div class="contenedor-estrecho">
    <section class="tarjeta">
        <div class="tarjeta-encabezado">
            <img src="~/imagenes/logo 1.png" alt="Emblema Asesoría Legal Global" class="logo-formulario" />
            <h1 class="tarjeta-titulo">Registro de Clientes</h1>
            <p class="tarjeta-subtitulo">Complete el formulario para dar de alta su cuenta y acceder a su espacio documental.</p>
        </div>

        <div asp-validation-summary="ModelOnly" class="alerta alerta-error"></div>

        <form method="post" novalidate>
            <div class="grupo-campo">
                <label asp-for="NombreApellido" class="etiqueta">Nombre y Apellido *</label>
                <input asp-for="NombreApellido" class="control-input" placeholder="Ej. Valentina Gómez" />
                <span asp-validation-for="NombreApellido" class="mensaje-error-campo"></span>
            </div>

            <div class="fila-campos">
                <div class="grupo-campo">
                    <label asp-for="Usuario" class="etiqueta">Nombre de Usuario *</label>
                    <input asp-for="Usuario" class="control-input" placeholder="Ej. vgomez" />
                    <span asp-validation-for="Usuario" class="mensaje-error-campo"></span>
                </div>

                <div class="grupo-campo">
                    <label asp-for="Edad" class="etiqueta">Edad  *</label>
                    <input asp-for="Edad" type="number" class="control-input" placeholder="Ej. 22" />
                    <span asp-validation-for="Edad" class="mensaje-error-campo"></span>
                </div>
            </div>

            <div class="grupo-campo">
                <label asp-for="Email" class="etiqueta">Correo Electrónico *</label>
                <input asp-for="Email" class="control-input" placeholder="cliente@ejemplo.com" />
                <span asp-validation-for="Email" class="mensaje-error-campo"></span>
            </div>

            <div class="fila-campos">
                <div class="grupo-campo">
                    <label asp-for="Password" class="etiqueta">Contraseña *</label>
                    <input asp-for="Password" class="control-input" />
                    <span asp-validation-for="Password" class="mensaje-error-campo"></span>
                </div>

                <div class="grupo-campo">
                    <label asp-for="ConfirmPassword" class="etiqueta">Confirmar Contraseña *</label>
                    <input asp-for="ConfirmPassword" class="control-input" />
                    <span asp-validation-for="ConfirmPassword" class="mensaje-error-campo"></span>
                </div>
            </div>

            <button type="submit" class="btn btn-primario btn-bloque">Registrar</button>

            <div class="pie-formulario">
                ¿Ya se encuentra registrado? <a asp-page="/Login">Iniciar sesión</a>
            </div>
        </form>
    </section>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

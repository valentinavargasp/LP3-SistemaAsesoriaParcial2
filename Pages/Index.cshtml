@page
@model IndexModel
@using Microsoft.AspNetCore.Http
@{
    ViewData["Title"] = "Inicio";
    string? usuarioActivo = HttpContext.Session.GetString("UsuarioLogueado");
}

@if (!string.IsNullOrEmpty(Model.MensajeRegistro))
{
    <div class="alerta alerta-exito" style="text-align: center; font-weight: 600;">
        ✅ @Model.MensajeRegistro
    </div>
}

<section class="hero-card">
    <img src="~/imagenes/logo 3.png" alt="Banner Corporativo Asesoría Legal Global" class="hero-banner" />

    <h1 class="hero-titulo">Asesoría Legal Global</h1>
    <p class="hero-descripcion">
        Brindamos servicios integrales de asesoramiento en temas jurídicos y corporativos.
        Regístrese en nuestra plataforma e inicie sesión para gestionar y resguardar sus documentos legales en un espacio personal seguro.
    </p>

    <div class="hero-acciones">
        @if (string.IsNullOrEmpty(usuarioActivo))
        {
            <a asp-page="/Registro" class="btn btn-primario">Registrarme como Cliente</a>
            <a asp-page="/Login" class="btn btn-secundario">Iniciar Sesión</a>
        }
        else
        {
            <a asp-page="/Documentos" class="btn btn-primario">Ir a Mi Espacio Documental (@usuarioActivo)</a>
            <a asp-page="/Salir" class="btn btn-secundario">Cerrar Sesión</a>
        }
    </div>
</section>

<section class="pilares-grid">
    <article class="pilar-card">
        <h3>1. Registro de Clientes</h3>
        <p>Alta rápida con validación de datos, mayoría de edad requerida y almacenamiento de credenciales en sesión y cookie.</p>
    </article>
    <article class="pilar-card">
        <h3>2. Inicio de Sesión</h3>
        <p>Autenticación de clientes registrados con redirección automática a su espacio personal de archivos.</p>
    </article>
    <article class="pilar-card">
        <h3>3. Resguardo Documental</h3>
        <p>Carga segura de escritos, contratos y expedientes en formatos autorizados con control de duplicados.</p>
    </article>
</section>
